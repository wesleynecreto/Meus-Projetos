{
  "manifest_version": 3,
  "name": "YouTube QR Code Clicavel",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["jsqr.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}