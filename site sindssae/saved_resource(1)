    },
	
	{
      src: "https://www.youtube.com/embed/YEnH-X3cRzg",
      title: "Aprendendo com o SINDSAAE"
    },
	
	
	
   
  ];

  let current = 0;
  const youtubePlayer = document.getElementById("youtubePlayer");
  const videoTitle = document.getElementById("videoTitle");

  function loadVideo(index) {
    const video = videos[index];
    youtubePlayer.src = video.src;
    videoTitle.textContent = video.title;
  }

  function changeVideo(direction) {
    current = (direction === "next")
      ? (current + 1) % videos.length
      : (current - 1 + videos.length) % videos.length;
    loadVideo(current);
  }

  loadVideo(current);

 
  let startX = null;
  window.addEventListener("mousedown", (e) => startX = e.clientX);
  window.addEventListener("mouseup", (e) => {
    if (startX !== null) {
      const deltaX = e.clientX - startX;
      if (Math.abs(deltaX) > 50) changeVideo(deltaX > 0 ? "prev" : "next");
      startX = null;
    }
  });

  let touchStartX = null;
  window.addEventListener("touchstart", (e) => touchStartX = e.touches[0].clientX);
  window.addEventListener("touchend", (e) => {
    const deltaX = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(deltaX) > 50) changeVideo(deltaX > 0 ? "prev" : "next");
    touchStartX = null;
  });

  document.getElementById("prevBtn").addEventListener("click", () => changeVideo("prev"));
  document.getElementById("nextBtn").addEventListener("click", () => changeVideo("next"));
</script>


